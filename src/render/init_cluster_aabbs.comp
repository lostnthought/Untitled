
#version 430 core
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform CameraData {
    vec4 cam_pos;
    vec4 cam_vel;
    mat4 projection;
    mat4 unjittered_projection;
    mat4 view;
    mat4 inv_projection;
    mat4 unjittered_inv_projection;
    mat4 inv_view;
};
layout(std140, binding = 1) uniform RenderingData {
    ivec4 resolution;
};
layout(std140, binding = 2) uniform LightCameraData {
    mat4 light_proj[4];
    mat4 light_view[4];
};

layout(std140, binding = 4) uniform PrevCameraData {
    vec4 prev_cam_pos;
    vec4 prev_cam_vel;
    mat4 prev_projection;
    mat4 prev_unjittered_projection;
    mat4 prev_view;
    mat4 prev_inv_projection;
    mat4 prev_unjittered_inv_projection;
    mat4 prev_inv_view;
};

struct AABB {
    vec4 min;
    vec4 max;
};

layout(std430, binding = 12) buffer ClusterAABBData {
    AABB cluster_AABBs[];
};

uniform uvec3 uGridSize;
uniform float uNear;
uniform float uFar;

uniform uvec2 uScreenDimensions;


vec3 screen_to_view_space(vec2 screen_coord) {
    vec4 ndc = vec4(screen_coord / uScreenDimensions.xy * 2.0 - 1.0, -1.0, 1.0);
    vec4 view_space = inv_projection * ndc;
    
    view_space /= view_space.w;
    
    return view_space.xyz;
}

vec3 line_intersection_z(vec3 start, vec3 end, float z)
{

    vec3 direction = end - start;
    vec3 normal = vec3(0, 0, -1);

    float t = (z - dot(normal, start)) / dot(normal, direction);

    return start + t * direction;
    
}



void main()
{
    
    uvec3 coord = gl_GlobalInvocationID.xyz;

    uint index = coord.x + (coord.y * uGridSize.x) + (coord.z * uGridSize.x * uGridSize.y);    

    vec2 tile_size = uScreenDimensions / vec2(uGridSize.xy);
    
    vec2 min_coord = vec2(coord.xy) * tile_size;
    vec2 max_coord = vec2(coord.xy + 1) * tile_size;


    vec3 min_tile = screen_to_view_space(min_coord);
    vec3 max_tile = screen_to_view_space(max_coord);

    float depth_ratio = uFar / uNear;
    float slice_near = uNear * pow(depth_ratio, float(coord.z) / float(uGridSize.z));
    float slice_far  = uNear * pow(depth_ratio, float(coord.z + 1) / float(uGridSize.z));

    vec3 min_near = line_intersection_z(vec3(0,0,0), min_tile, slice_near);
    vec3 min_far = line_intersection_z(vec3(0,0,0), min_tile, slice_far);
    vec3 max_near = line_intersection_z(vec3(0,0,0), max_tile, slice_near);
    vec3 max_far = line_intersection_z(vec3(0,0,0), max_tile, slice_far);

    

    cluster_AABBs[index].min = vec4(min(min_near, min_far), 1.0);
    cluster_AABBs[index].max = vec4(max(max_near, max_far), 1.0);    



    
}
