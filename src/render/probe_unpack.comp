

#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;



struct SHData
{
    vec3 pos;
    uint pad0;
    vec4 coefficients[9];
};

layout(std430, binding = 9) buffer ProbeData {
    SHData probes[];
};

layout(std430, binding = 11) buffer ProbeOutData {
    float data[];
};


uniform ivec3 uProbeSize;
uniform uint uPaddedDepth;
uniform int uIterations;

void main()
{
    
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    if (coord.x >= uProbeSize.x || coord.y >= uProbeSize.y || coord.z >= uProbeSize.z) return;

    int index = coord.z * uProbeSize.y * uProbeSize.x + coord.y * uProbeSize.x + coord.x;
    int offset_z = coord.z + 1;
    int padded_index = -1;
    if (coord.z == 0)
    {
        padded_index = 0;
    }
    else if (coord.z == uProbeSize.z - 1)
    {
        padded_index = int(uPaddedDepth) - 1;
    }
    coord.z = offset_z;
    float weight = (4 * 3.14159265359) / float(uIterations);
    for (int i = 0; i < 9; i++)
    {
        ivec3 current_coord = coord * 3;
        current_coord.z += int(uPaddedDepth) * i * 3;
        int current_index = current_coord.z * uProbeSize.y * uProbeSize.x + current_coord.y * uProbeSize.x + current_coord.x;
        vec4 c = probes[index].coefficients[i] * weight;
        if (i == 0)
        {
        
            c *= 1.0f;
        }
        else if (i <= 3)
        {
        
            c *= 2.0f/3.0f;
        }
        else
        {
            c *= 1.0f/4.0f;
        }
    
        data[current_index + 0] = c.x;
        data[current_index + 1] = c.y;
        data[current_index + 2] = c.z;


        if (padded_index != -1)
        {
            ivec3 padded_coord = coord;
            padded_coord.z = padded_index;
            padded_coord *= 3;
            padded_coord.z += int(uPaddedDepth) * i * 3;
            int padded = padded_coord.z * uProbeSize.y * uProbeSize.x + padded_coord.y * uProbeSize.x + padded_coord.x;
    
            data[padded+ 0] = c.x;
            data[padded+ 1] = c.y;
            data[padded+ 2] = c.z;
        }
    }

    
    
}


