#version 430 core
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;


struct DrawArraysIndirectCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
    uint instanceOffset; // the amount of instances pushed this frame
    uint pad0;
};


layout(std430, binding = 5) buffer DrawArraysData {

    DrawArraysIndirectCommand draw_arrays_commands[];
};


struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
    uint instanceOffset; // the amount of instances pushed this frame
};

layout(std430, binding = 6) buffer DrawElementsData {

    DrawElementsIndirectCommand draw_elements_commands[];
};

struct MeshNode
{
    vec4 min;
    vec4 max;
    vec4 center;
    vec4 extents;
    uint instance_count;
    uint static_mesh;
    uint lm_offset;
    uint material;
    uint first;
    uint count;
    uint pad0;
    uint pad1;
};

#define MAX_MESH_NODES 1024
layout(std430, binding = 15) buffer MeshNodeData {

    float focal_distance;
    uint pad0;
    uint pad1;
    uint pad2;
    MeshNode mns[MAX_MESH_NODES];

};


#define MAX_INSTANCES 1024
layout(std430, binding = 4) buffer VisibleData {

    uint visible_indices[];

};


struct Transform
{
    uint mn_id;
    uint command_id;
    uvec2 directional_lights;
    uvec2 spot_lights;
    uint skin_offset;
    uint material;
    mat4 mat;
};

layout(std430, binding = 7) buffer TransformData {

    Transform trs[];

};

uniform uint uInstanceCount;
uniform vec4 planes[6];
uniform uint uArrayOffset;

struct AABBBounds
{
    vec4 min;
    vec4 max;
};


AABBBounds transform_aabb_by_model_matrix(MeshNode mn, mat4 mat)
{

    vec3 center = (mat * mn.center).xyz;

    vec3 AX = (mat * vec4(1,0,0, 0.0)).xyz;
    vec3 AY = (mat * vec4(0,1,0, 0.0)).xyz;
    vec3 AZ = (mat * vec4(0,0,1, 0.0)).xyz;


    vec3 new_extents;
    new_extents.x = abs(AX.x) * mn.extents.x + abs(AY.x) * mn.extents.y + abs(AZ.x) * mn.extents.z;
    new_extents.y = abs(AX.y) * mn.extents.x + abs(AY.y) * mn.extents.y + abs(AZ.y) * mn.extents.z;
    new_extents.z = abs(AX.z) * mn.extents.x + abs(AY.z) * mn.extents.y + abs(AZ.z) * mn.extents.z;

    AABBBounds aabb;
    
    aabb.min.x = mn.center.x - new_extents.x;
    aabb.min.y = mn.center.y - new_extents.y;
    aabb.min.z = mn.center.z - new_extents.z;
    aabb.max.x = mn.center.x + new_extents.x;
    aabb.max.y = mn.center.y + new_extents.y;
    aabb.max.z = mn.center.z + new_extents.z;

    return aabb;
    
}

bool aabb_in_frustum (vec3 min, vec3 max)
{
    for (int i = 0; i < 6; i++)
    {
        vec3 p = vec3(
            planes[i].x >= 0.0f ? max.x : min.x,
            planes[i].y >= 0.0f ? max.y : min.y,
            planes[i].z >= 0.0f ? max.z : min.z
        );

        if (dot(planes[i].xyz, p) + planes[i].w < 0.0f)
        {
            return false;
        }
    }

    return true;
}

void main()
{

    uint instance_id = gl_GlobalInvocationID.x;
    if (instance_id >= uInstanceCount) return;

    
    Transform tr = trs[instance_id];
    MeshNode mn = mns[tr.mn_id];
    // before cull
    if (mn.static_mesh == 1)
    {
         atomicAdd(draw_arrays_commands[tr.command_id].instanceOffset, 1);

    }
    else
    {
        atomicAdd(draw_elements_commands[tr.command_id].instanceOffset, 1);
    }


    // vec3 min = (tr.mat * mn.min).xyz;
    // vec3 max = (tr.mat * mn.max).xyz;


    // AABBBounds bounds = transform_aabb_by_model_matrix(mn, tr.mat);
    
    // if (!aabb_in_frustum(bounds.min, bounds.max)) return;
    
    

    // cull

    uint offset = MAX_INSTANCES * tr.command_id;
    if (mn.static_mesh == 1)
    {
         uint count = atomicAdd(draw_arrays_commands[tr.command_id].instanceCount, 1);

         visible_indices[offset + count] = instance_id;
    }
    else
    {
        offset += MAX_INSTANCES * uArrayOffset;
        uint count = atomicAdd(draw_elements_commands[tr.command_id].instanceCount, 1);
         visible_indices[offset + count] = instance_id;
    }
    


    
}

