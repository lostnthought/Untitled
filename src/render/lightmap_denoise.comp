
#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) uniform readonly  image2D uInputLightmap;
layout(rgba32f, binding = 1) uniform writeonly image2D uOutputLightmap;
layout(rgba16f, binding = 2) uniform readonly  image2D uInputDir;
layout(rgba16f, binding = 3) uniform writeonly image2D uOutputDir;

uniform sampler2D uLightmapPosTex;
uniform sampler2D uLightmapNormalTex;
uniform isampler2D uLightmapIDTex;
uniform int uLightmapWidth;
uniform int uLightmapHeight;

const int KERNEL_RADIUS = 4; 

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x < 0 || coord.y < 0 || coord.x >= uLightmapWidth || coord.y >= uLightmapHeight) return;
    
    vec4 center_color  = imageLoad(uInputLightmap, coord);
    vec4 center_dir = imageLoad(uInputDir, coord);
    // imageStore(uOutputLightmap, coord, center_color);
    // imageStore(uOutputDir, coord, center_dir);
    // return;
    vec3 center_pos  = texelFetch(uLightmapPosTex, coord, 0).rgb;
    vec3 center_normal = texelFetch(uLightmapNormalTex, coord, 0).rgb;
    ivec3 ids = texelFetch(uLightmapIDTex, coord, 0).rgb;

    if (ids.y < 0) {
        imageStore(uOutputLightmap, coord, vec4(0.0));
        imageStore(uOutputDir, coord, vec4(0.0));
        return;
    }

    vec4 sum_color = vec4(0.0);
    vec4 sum_dir = vec4(0.0);
    float total_weight = 0.0;

    for (int y = -KERNEL_RADIUS; y <= KERNEL_RADIUS; y++) {
        for (int x = -KERNEL_RADIUS; x <= KERNEL_RADIUS; x++) {
            ivec2 neighbor_coord = coord + ivec2(x, y);
            if (neighbor_coord.x < 0 || neighbor_coord.y < 0 || neighbor_coord.x >= uLightmapWidth || neighbor_coord.y >= uLightmapHeight) continue;

            vec4 neighbor_color = imageLoad(uInputLightmap, neighbor_coord);
            vec4 neighbor_dir = imageLoad(uInputDir, neighbor_coord);
            vec3 neighbor_pos = texelFetch(uLightmapPosTex, neighbor_coord, 0).rgb;
            vec3 neighbor_normal = texelFetch(uLightmapNormalTex, neighbor_coord, 0).rgb;
            ivec3 neighbor_ids = texelFetch(uLightmapIDTex, neighbor_coord, 0).rgb;
            if (neighbor_ids.y < 0) continue;

            float dist_sq = float(x*x + y*y);
            float w_spatial = exp(-dist_sq / 16.0);

            float normal_dot = max(0.0, dot(center_normal, neighbor_normal));
            float w_normal = pow(normal_dot, 16.0); 

            float pos_dist_sq = dot(center_pos - neighbor_pos, center_pos - neighbor_pos);
            float w_position = exp(-pos_dist_sq / 0.05);
            // float w_position = exp(-pos_dist_sq / 0.2);

            float weight = w_spatial * w_normal * w_position;

            sum_color += neighbor_color * weight;
            sum_dir += neighbor_dir * weight;
            total_weight += weight;
        }
    }

    vec4 final_color = (total_weight > 0.0) ? (sum_color / total_weight) : center_color;
    vec4 final_dir = (total_weight > 0.0) ? (sum_dir / total_weight) : center_dir;
    imageStore(uOutputLightmap, coord, final_color);
    imageStore(uOutputDir, coord, final_dir);
    // imageStore(uOutputLightmap, coord, vec4(total_weight,0,0,1));
    // imageStore(uOutputDir, coord, final_dir);
}
