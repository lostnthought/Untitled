
#version 430 core
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;


struct DrawArraysIndirectCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
    uint instanceOffset; // the amount of instances pushed this frame
    uint pad0;
};


layout(std430, binding = 5) buffer DrawArraysData {

    DrawArraysIndirectCommand draw_arrays_commands[];
};


struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
    uint instanceOffset; // the amount of instances pushed this frame
};

layout(std430, binding = 6) buffer DrawElementsData {

    DrawElementsIndirectCommand draw_elements_commands[];
};

struct MeshNode
{
    vec4 min;
    vec4 max;
    vec4 center;
    vec4 extents;
    uint instance_count;
    uint static_mesh;
    uint lm_offset;
    uint material;
    uint first;
    uint count;
    uint pad0;
    uint pad1;
};

#define MAX_MESH_NODES 1024
layout(std430, binding = 15) buffer MeshNodeData {

    float focal_distance;
    uint pad0;
    uint pad1;
    uint pad2;
    MeshNode mns[MAX_MESH_NODES];

};

struct Transform
{
    uint mn_id;
    uint command_id;
    uvec2 directional_lights;
    uvec2 spot_lights;
    uint skin_offset;
    uint pad0;
    mat4 mat;
};

layout(std430, binding = 7) buffer TransformData {

    Transform trs[];

};

#define MAX_INSTANCES 1024
layout(std430, binding = 4) buffer VisibleData {

    uint visible_indices[];

};
uniform vec3 uLightPos;
uniform float uLightRadius;
uniform uint uInstanceCount;
uniform uint uArrayOffset;
bool test_sphere_aabb(vec3 light_pos, float light_radius, vec4 min, vec4 max)
{
    
    vec3 closest_point = clamp(light_pos, min.xyz, max.xyz);
    
    vec3 delta = light_pos - closest_point;
    
    return dot(delta, delta) <= (light_radius * light_radius);
}

void main()
{

    uint instance_id = gl_GlobalInvocationID.x;
    if (instance_id >= uInstanceCount) return;


    // cull
    Transform tr = trs[instance_id];
    MeshNode mn = mns[tr.mn_id];

    
    vec4 min = tr.mat * mn.min;
    vec4 max = tr.mat * mn.max;

    if (mn.static_mesh == 1)
    {
         atomicAdd(draw_arrays_commands[tr.command_id].instanceOffset, 1);

    }
    else
    {
        atomicAdd(draw_elements_commands[tr.command_id].instanceOffset, 1);
    }

    if (!test_sphere_aabb(uLightPos, uLightRadius, min, max))
    {
        return;
    }
    
    uint offset = MAX_INSTANCES * tr.command_id;
    if (mn.static_mesh == 1)
    {
         uint count = atomicAdd(draw_arrays_commands[tr.command_id].instanceCount, 1);

         visible_indices[offset + count] = instance_id;
    }
    else
    {
        offset += MAX_INSTANCES * uArrayOffset;
        uint count = atomicAdd(draw_elements_commands[tr.command_id].instanceCount, 1);
         visible_indices[offset + count] = instance_id;
    }
    


    
}

